aside.aut-lateral.comp-tarjeta
  if cejaAuth
    p.aut-ceja= cejaAuth
  h1.aut-titulo= tituloAuth
  if textoAuth
    p.aut-texto= textoAuth

  if modoAuth === 'inicio-sesion'
    p.aut-cambio
      | Todavia no tenes cuenta?
      br
      br
      a.comp-btn(href='/registro') Crear cuenta
  else if modoAuth === 'registro'
    p.aut-cambio
      | Ya tenes cuenta?
      br
      br
      a.comp-btn.comp-btn--suave(href='/iniciar-sesion') Iniciar sesion
  else
    p.aut-cambio
      | Volver al acceso principal?
      br
      br
      a.comp-btn.comp-btn--suave(href='/iniciar-sesion') Iniciar sesion
