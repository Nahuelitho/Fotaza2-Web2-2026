article.post-card.card-soft
  - var safePost = post || {}
  - var safeAuthor = safePost.author || 'Autor'
  - var safeTags = safePost.tags || []
  .post-card__header
    .post-card__identity
      .post-card__avatar= safeAuthor.charAt(0)
      .post-card__meta
        h3= safeAuthor
        p #{safePost.handle || '@fotaza'} · #{safePost.location || 'Ubicacion pendiente'}
    button.post-card__menu(type='button', aria-label='Opciones de la publicacion') ...

  .post-card__media
    span.post-card__label= safePost.imageLabel || 'Preview visual'

  .post-card__body
    h4= safePost.title || 'Publicacion en preparacion'
    p= safePost.description || 'Esta tarjeta va a mostrar informacion real cuando conectemos el modulo de publicaciones.'
    .tag-row
      each tag in safeTags
        span.tag-pill.tag-pill--soft= tag

  .post-card__footer
    span.post-card__stats= safePost.stats || 'Sin interacciones todavia'
    .post-card__actions
      a(href='#') Valorar
      a(href='#') Comentar
      a(href='#') Guardar
