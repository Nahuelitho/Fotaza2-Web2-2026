header.topbar
  .topbar-inner.container
    .topbar-brand
      a.brand(href='/') Fotaza 2
      span.brand-tag Comunidad visual

    .topbar-search
      label.sr-only(for='site-search') Buscar contenido
      input#site-search(type='search', placeholder='Buscar publicaciones, autores o etiquetas')

    nav.topbar-nav(aria-label='Navegacion principal')
      a.icon-link.is-active(href='/')
        span.icon-link__symbol +
        span.icon-link__label Inicio
      a.icon-link(href='#')
        span.icon-link__symbol *
        span.icon-link__label Explorar
      a.icon-link(href='#')
        span.icon-link__symbol #
        span.icon-link__label Tendencias

    .topbar-actions
      if currentUser
        span.user-chip Hola, #{currentUser.displayName}
        form(action='/logout', method='post')
          button.button.button-soft(type='submit') Cerrar sesion
      else
        a.button.button-soft(href='/register') Crear cuenta
        a.button(href='/login') Iniciar sesion
      button.menu-toggle(type='button', aria-label='Abrir menu')
        span.menu-toggle__line
        span.menu-toggle__line
        span.menu-toggle__line
