aside.sidebar-column
  - var safeQuickLinks = accesosRapidos || []
  - var safeFeaturedTags = etiquetasDestacadas || []
  section.card-soft.profile-brief
    .profile-brief__avatar NV
    .profile-brief__content
      h2 Fotaza 2
      p.profile-brief__text Plataforma en desarrollo.

  section.card-soft
    .section-heading
      h3 Accesos rapidos
    ul.link-stack
      each link in safeQuickLinks
        li
          a(href='#')= link

  section.card-soft
    .section-heading
      h3 Etiquetas en tendencia
    .tag-cloud
      each tag in safeFeaturedTags
        a.tag-pill(href='#')= tag
