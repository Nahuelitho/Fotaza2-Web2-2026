aside.auth-aside.card-soft
  if cejaAuth
    p.eyebrow= cejaAuth
  h1.auth-title= tituloAuth
  if textoAuth
    p.auth-text= textoAuth

  if modoAuth === 'inicio-sesion'
    p.auth-switch
      | Todavia no tienes cuenta?
      br
      a(href='/registro') Crear cuenta
  else if modoAuth === 'registro'
    p.auth-switch
      | Ya tienes cuenta?
      a(href='/iniciar-sesion') Iniciar sesion
  else
    p.auth-switch
      | Volver al acceso principal?
      a(href='/iniciar-sesion') Iniciar sesion
