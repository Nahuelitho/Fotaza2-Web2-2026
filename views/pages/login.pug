extends ../layouts/main

block content
  .auth-shell.container
    .auth-grid
      include ../partials/auth-aside

      section.auth-card.card-soft
        .section-heading.auth-card__heading
          h2 Iniciar sesion

        if errorMessage
          p.form-message.form-message--error= errorMessage

        form.auth-form(action='/login', method='post')
          label.auth-field
            span Correo o usuario
            input(type='text', name='identifier', placeholder='tuusuario o correo@ejemplo.com', value=(formData && formData.identifier) || '')

          label.auth-field
            span Contrasena
            input(type='password', name='password', placeholder='Ingresa tu contrasena')

          .auth-form__actions
            button.button(type='submit') Iniciar sesion
            a.auth-link(href='/forgot-password') Olvide mi contrasena
