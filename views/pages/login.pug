extends ../layouts/main

block content
  .auth-shell.container
    .auth-grid
      include ../partials/auth-aside

      section.auth-card.card-soft
        .section-heading.auth-card__heading
          h2 Iniciar sesion

        if mensajeError
          p.form-message.form-message--error= mensajeError

        form.auth-form(action='/iniciar-sesion', method='post')
          label.auth-field
            span Correo o usuario
            input(type='text', name='identificador', placeholder='tuusuario o correo@ejemplo.com', value=(datosFormulario && datosFormulario.identificador) || '')

          label.auth-field
            span Contrasena
            input(type='password', name='contrasena', placeholder='Ingresa tu contrasena')

          .auth-form__actions
            button.button(type='submit') Iniciar sesion
            a.auth-link(href='/recuperar-contrasena') Olvide mi contrasena
