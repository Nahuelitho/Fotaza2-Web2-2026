extends ../layouts/main

block content
  - var safeFeaturedTags = featuredTags || []
  .home-shell.container
    .home-grid
      include ../partials/home-sidebar

      section.feed-column
        include ../partials/home-hero

        section.card-soft
          .section-heading
            h2 Inicio
            p Proyecto en desarrollo.

      aside.right-rail
        section.card-soft
          .section-heading
            h3 Desarrollo
          p.rail-note Modulos en construccion.
        section.card-soft
          .section-heading
            h3 Etiquetas previstas
          .tag-cloud
            each tag in safeFeaturedTags
              a.tag-pill(href='#')= tag
