extends ../layouts/main

block content
  .home-shell.container
    .home-grid
      include ../partials/home-sidebar

      section.feed-column
        include ../partials/home-hero

        section.feed-toolbar.card-soft
          .section-heading
            h2 Publicaciones destacadas
            p Mockups visuales para definir el look del home antes del CRUD real.
          .feed-toolbar__actions
            a.button.button-soft(href='#') Crear cuenta
            a.button.button-ghost(href='#') Ver mas

        .post-feed
          each post in posts
            include ../partials/post-card

      aside.right-rail
        section.card-soft
          .section-heading
            h3 Descubrir
          p.rail-note Una columna simple para destacar etiquetas, autores o sugerencias sin recargar el home.
          .tag-cloud
            each tag in featuredTags
              a.tag-pill(href='#')= tag
