extends ../layouts/main

block content
  .aut-lienzo.ly-cont
    .aut-grilla
      include ../partials/autenticacion-lateral

      section.aut-tar.comp-tarjeta
        .comp-cabecera.aut-tar__cab
          h2 Recuperar contrasena

        form.aut-form(action='#', method='post')
          label.aut-campo
            span Correo electronico
            input(type='email', name='correo', placeholder='correo@ejemplo.com')

          .aut-form__acciones
            button.comp-btn(type='submit') Enviar enlace
            a.aut-link(href='/iniciar-sesion') Volver a iniciar sesion
