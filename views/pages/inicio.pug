extends ../layouts/main

block content
  - var publicacionesSeguras = publicaciones || []
  .ini-lienzo.ly-cont
    .ini-grilla
      include ../partials/inicio-barra-lateral

      section.ini-feed
        include ../partials/inicio-hero

        section.comp-tarjeta
          if mensajeEstado
            p.comp-msg.comp-msg--ok= mensajeEstado
          if mensajeError
            p.comp-msg.comp-msg--error= mensajeError
          .ini-agregar
            if usuarioActual
              button.ini-agregar__btn(type='button', data-open-post-modal='true', aria-haspopup='dialog')
                span.ini-agregar__ico +
                span Agregar publicacion
            else
              button.ini-agregar__btn(type='button', data-open-auth-modal='true', aria-haspopup='dialog')
                span.ini-agregar__ico +
                span Agregar publicacion


        section.comp-tarjeta
          .comp-cabecera
            h3 Publicaciones
          if publicacionesSeguras.length === 0
            p.comp-nota Todavia no hay publicaciones.
          else
            .ini-posts
              each publicacion in publicacionesSeguras
                - var imagen = (publicacion.imagenes && publicacion.imagenes[0]) || null
                - var etiquetas = publicacion.etiquetas || []
                article.ini-post
                  .ini-post__cab
                    h4= publicacion.titulo
                    if publicacion.usuario
                      span.ini-post__autor= '@' + publicacion.usuario.nombreUsuario
                  if publicacion.descripcion
                    p.ini-post__desc= publicacion.descripcion
                  if imagen
                    img.ini-post__img(src=`data:${imagen.tipoMime};base64,${imagen.imagenBase64}`, alt=publicacion.titulo)
                    p.ini-post__meta
                      | Licencia: #{imagen.tipoLicencia === 'creative_commons' ? 'Sin copyright (Creative Commons)' : 'Con copyright'}
                      if imagen.textoMarcaAgua
                        |  · Marca de agua: #{imagen.textoMarcaAgua}
                  if etiquetas.length > 0
                    .comp-tags
                      each etiqueta in etiquetas
                        span.comp-tag.comp-tag--suave= etiqueta.name
                  .ini-post__acciones
                    a.comp-btn.comp-btn--fantasma(href=`/publicaciones/${publicacion.id}`) Ver detalle

  if usuarioActual
    .comp-modal#post-modal(hidden=true)
      .comp-modal__caja.comp-tarjeta(role='dialog', aria-modal='true', aria-labelledby='post-modal-title')
        .comp-cabecera
          h3#post-modal-title Nueva publicacion
          button.comp-modal__cerrar(type='button', data-close-post-modal='true', aria-label='Cerrar') x

        form.aut-form(action='/publicaciones', method='post', enctype='multipart/form-data')
          label.aut-campo
            span Titulo
            input(type='text', name='titulo', required, maxlength='150')

          label.aut-campo
            span Descripcion (opcional)
            input(type='text', name='descripcion', maxlength='500')

          label.aut-campo
            span Imagen
            input(type='file', name='imagen', accept='image/jpeg,image/png,image/webp', required)

          .aut-form__fila
            label.aut-campo
              span Licencia
              select(name='tipoLicencia', required, data-license-type='true')
                option(value='') Seleccionar
                option(value='con_copyright') Con copyright
                option(value='creative_commons') Sin copyright (Creative Commons)

            label.aut-campo
              span Marca de agua
              input(type='text', name='textoMarcaAgua', maxlength='100', data-watermark='true')

          p.comp-nota Imagen maxima: 2MB. Formatos: JPG, PNG o WEBP.

          fieldset.aut-campo.ini-tags-campo
            span Tags (elegi entre 1 y 3)
            .ini-tags-selector
              select(data-tag-select='true')
                option(value='') Seleccionar tag
                each etiqueta in etiquetasDisponibles
                  option(value=etiqueta.name)= etiqueta.name
              button.comp-btn.comp-btn--fantasma(type='button', data-add-existing-tag='true') Agregar

          .aut-campo
            span Agregar tag nuevo (opcional)
            .ini-tags-selector
              input(type='text', maxlength='50', placeholder='Ej: deportes', data-new-tag='true')
              button.comp-btn.comp-btn--fantasma(type='button', data-add-new-tag='true') Crear

          .ini-tags-elegidos(data-selected-tags='true')

          p.comp-nota Podes combinar tags existentes y un tag nuevo. Maximo: 3.

          .aut-form__acciones
            button.comp-btn(type='submit') Publicar
            button.comp-btn.comp-btn--cancelar(type='button', data-close-post-modal='true') Cancelar
  else
    .comp-modal#auth-required-modal(hidden=true)
      .comp-modal__caja.comp-tarjeta(role='dialog', aria-modal='true', aria-labelledby='auth-required-title')
        .comp-cabecera
          h3#auth-required-title Necesitas una cuenta
          button.comp-modal__cerrar(type='button', data-close-auth-modal='true', aria-label='Cerrar') x

        p.comp-nota Para crear una publicacion tenes que iniciar sesion o crear una cuenta.

        .aut-form__acciones
          a.comp-btn(href='/registro') Crear cuenta
          a.comp-btn.comp-btn--suave(href='/iniciar-sesion') Iniciar sesion
          button.comp-btn.comp-btn--cancelar(type='button', data-close-auth-modal='true') Cancelar

  script(src='/js/inicio.js')
