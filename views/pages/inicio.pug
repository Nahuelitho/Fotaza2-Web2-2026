extends ../layouts/main

block content
  - var publicacionesSeguras = publicaciones || []
  .ini-lienzo.ly-cont
    .ini-grilla
      include ../partials/inicio-barra-lateral

      section.ini-feed
        include ../partials/inicio-hero

        section.comp-tarjeta
          if mensajeEstado
            p.comp-msg.comp-msg--ok= mensajeEstado
          if mensajeError
            p.comp-msg.comp-msg--error= mensajeError
          .ini-agregar
            if usuarioActual
              button.ini-agregar__btn(type='button', data-open-post-modal='true', aria-haspopup='dialog')
                span.ini-agregar__ico +
                span Agregar publicacion
            else
              a.ini-agregar__btn(href='/iniciar-sesion')
                span.ini-agregar__ico +
                span Agregar publicacion


        section.comp-tarjeta
          .comp-cabecera
            h3 Publicaciones
          if publicacionesSeguras.length === 0
            p.comp-nota Todavia no hay publicaciones.
          else
            .ini-posts
              each publicacion in publicacionesSeguras
                - var imagen = (publicacion.imagenes && publicacion.imagenes[0]) || null
                - var etiquetas = publicacion.etiquetas || []
                article.ini-post
                  .ini-post__cab
                    h4= publicacion.titulo
                    if publicacion.usuario
                      span.ini-post__autor= '@' + publicacion.usuario.nombreUsuario
                  if publicacion.descripcion
                    p.ini-post__desc= publicacion.descripcion
                  if imagen
                    img.ini-post__img(src=`data:${imagen.tipoMime};base64,${imagen.imagenBase64}`, alt=publicacion.titulo)
                    p.ini-post__meta
                      | Licencia: #{imagen.tipoLicencia === 'creative_commons' ? 'Sin copyright (Creative Commons)' : 'Con copyright'}
                      if imagen.textoMarcaAgua
                        |  · Marca de agua: #{imagen.textoMarcaAgua}
                  if etiquetas.length > 0
                    .comp-tags
                      each etiqueta in etiquetas
                        span.comp-tag.comp-tag--suave= etiqueta.name

  if usuarioActual
    .comp-modal#post-modal(hidden)
      .comp-modal__caja.comp-tarjeta(role='dialog', aria-modal='true', aria-labelledby='post-modal-title')
        .comp-cabecera
          h3#post-modal-title Nueva publicacion
          button.comp-modal__cerrar(type='button', data-close-post-modal='true', aria-label='Cerrar') x

        form.aut-form(action='/publicaciones', method='post', enctype='multipart/form-data')
          label.aut-campo
            span Titulo
            input(type='text', name='titulo', required, maxlength='150')

          label.aut-campo
            span Descripcion (opcional)
            input(type='text', name='descripcion', maxlength='500')

          label.aut-campo
            span Imagen
            input(type='file', name='imagen', accept='image/jpeg,image/png,image/webp', required)

          .aut-form__fila
            label.aut-campo
              span Licencia
              select(name='tipoLicencia', required, data-license-type='true')
                option(value='') Seleccionar
                option(value='con_copyright') Con copyright
                option(value='creative_commons') Sin copyright (Creative Commons)

            label.aut-campo
              span Marca de agua
              input(type='text', name='textoMarcaAgua', maxlength='100', data-watermark='true')

          p.comp-nota Imagen maxima: 2MB. Formatos: JPG, PNG o WEBP.

          label.aut-campo
            span Tags (separados por coma)
            input(type='text', name='etiquetas', required, placeholder='paisaje, viaje')

          .aut-form__acciones
            button.comp-btn(type='submit') Publicar
            button.comp-btn.comp-btn--fantasma(type='button', data-close-post-modal='true') Cancelar

    script.
      (function () {
        var openButton = document.querySelector('[data-open-post-modal="true"]');
        var modal = document.getElementById('post-modal');
        var closeButtons = document.querySelectorAll('[data-close-post-modal="true"]');
        var licenseSelect = document.querySelector('[data-license-type="true"]');
        var watermarkInput = document.querySelector('[data-watermark="true"]');
        var form = modal.querySelector('form');
        var imageInput = modal.querySelector('input[name="imagen"]');

        if (!modal || !openButton) return;

        function updateWatermarkState() {
          if (!licenseSelect || !watermarkInput) return;
          var requiresWatermark = licenseSelect.value === 'con_copyright';
          watermarkInput.required = requiresWatermark;
          watermarkInput.disabled = !requiresWatermark;
          if (!requiresWatermark) {
            watermarkInput.value = '';
          }
        }

        openButton.addEventListener('click', function () {
          modal.hidden = false;
        });

        closeButtons.forEach(function (button) {
          button.addEventListener('click', function () {
            modal.hidden = true;
          });
        });

        modal.addEventListener('click', function (event) {
          if (event.target === modal) {
            modal.hidden = true;
          }
        });

        if (licenseSelect) {
          licenseSelect.addEventListener('change', updateWatermarkState);
          updateWatermarkState();
        }

        if (form && imageInput) {
          form.addEventListener('submit', function (event) {
            var file = imageInput.files && imageInput.files[0];
            if (!file) return;
            if (file.size > 2 * 1024 * 1024) {
              event.preventDefault();
              alert('La imagen supera el tamano maximo permitido (2MB).');
            }
          });
        }

        if (window.location.search.indexOf('estado=creada') >= 0 || window.location.search.indexOf('error=') >= 0) {
          window.history.replaceState({}, document.title, '/');
        }
      })();
