extends ../layouts/main

block content
  - var publicacionesSeguras = publicaciones || []
  .ini-lienzo.ly-cont
    .ini-grilla
      include ../partials/inicio-barra-lateral

      section.ini-feed
        include ../partials/inicio-hero

        section.comp-tarjeta
          if mensajeEstado
            p.comp-msg.comp-msg--ok= mensajeEstado
          if mensajeError
            p.comp-msg.comp-msg--error= mensajeError
          if rutaActual === '/'
            .ini-agregar
              if usuarioActual
                button.ini-agregar__btn(type='button', data-abrir-modal-publicacion='true', aria-haspopup='dialog')
                  span.ini-agregar__ico +
                  span Agregar publicacion
              else
                button.ini-agregar__btn(type='button', data-abrir-modal-autenticacion='true', aria-haspopup='dialog')
                  span.ini-agregar__ico +
                  span Agregar publicacion


        section.comp-tarjeta
          .comp-cabecera
            h3 Publicaciones
          if publicacionesSeguras.length === 0
            p.comp-nota Todavia no hay publicaciones para mostrar.
          else
            .ini-posts
              each publicacion in publicacionesSeguras
                - var mostrarAutor = true
                include ../partials/publicacion-card

              if paginacion && paginacion.totalPaginas > 1
                nav.ini-paginacion(aria-label='Paginacion de publicaciones')
                  if paginacion.tieneAnterior
                    a.comp-btn.comp-btn--fantasma(href=paginacion.urlAnterior) Anterior
                  span.ini-paginacion__estado Pagina #{paginacion.paginaActual} de #{paginacion.totalPaginas}
                  if paginacion.tieneSiguiente
                    a.comp-btn.comp-btn--fantasma(href=paginacion.urlSiguiente) Siguiente

  if usuarioActual
    .comp-modal#post-modal(hidden=true)
      .comp-modal__caja.comp-tarjeta(role='dialog', aria-modal='true', aria-labelledby='post-modal-title')
        .comp-cabecera
          h3#post-modal-title Nueva publicacion
          button.comp-modal__cerrar(type='button', data-cerrar-modal-publicacion='true', aria-label='Cerrar') x

        form.aut-form(action='/publicaciones', method='post', enctype='multipart/form-data')
          label.aut-campo
            span Titulo
            input(type='text', name='titulo', required, maxlength='150')

          label.aut-campo
            span Descripcion (opcional)
            input(type='text', name='descripcion', maxlength='500')

          label.aut-campo
            span Imagen
            input(type='file', name='imagen', accept='image/jpeg,image/png,image/webp', required)

          .aut-form__fila
            label.aut-campo
              span Licencia
              select(name='tipoLicencia', required, data-tipo-licencia='true')
                option(value='') Seleccionar
                option(value='con_copyright') Con copyright
                option(value='creative_commons') Sin copyright (Creative Commons)

            label.aut-campo
              span Marca de agua
              input(type='text', name='textoMarcaAgua', maxlength='100', data-marca-agua='true')

          p.comp-nota Imagen maxima: 2MB. Formatos: JPG, PNG o WEBP.

          fieldset.aut-campo.ini-tags-campo
            span Tags (elegi entre 1 y 3)
            .ini-tags-selector
              select(data-select-etiqueta='true')
                option(value='') Seleccionar tag
                each etiqueta in etiquetasDisponibles
                  option(value=etiqueta.name)= etiqueta.name
              button.comp-btn.comp-btn--fantasma(type='button', data-agregar-etiqueta-existente='true') Agregar

          .aut-campo
            span Agregar tag nuevo (opcional)
            .ini-tags-selector
              input(type='text', maxlength='50', placeholder='Ej: deportes', data-etiqueta-nueva='true')
              button.comp-btn.comp-btn--fantasma(type='button', data-crear-etiqueta-nueva='true') Crear

          .ini-tags-elegidos(data-etiquetas-elegidas='true')

          p.comp-nota Podes combinar tags existentes y un tag nuevo. Maximo: 3.

          .aut-form__acciones
            button.comp-btn(type='submit') Publicar
            button.comp-btn.comp-btn--cancelar(type='button', data-cerrar-modal-publicacion='true') Cancelar
  else
    .comp-modal#auth-required-modal(hidden=true)
      .comp-modal__caja.comp-tarjeta(role='dialog', aria-modal='true', aria-labelledby='auth-required-title')
        .comp-cabecera
          h3#auth-required-title Necesitas una cuenta
          button.comp-modal__cerrar(type='button', data-cerrar-modal-autenticacion='true', aria-label='Cerrar') x

        p.comp-nota Para crear una publicacion tenes que iniciar sesion o crear una cuenta.

        .aut-form__acciones
          a.comp-btn(href='/registro') Crear cuenta
          a.comp-btn.comp-btn--suave(href='/iniciar-sesion') Iniciar sesion
          button.comp-btn.comp-btn--cancelar(type='button', data-cerrar-modal-autenticacion='true') Cancelar

  script(src='/js/inicio.js')
