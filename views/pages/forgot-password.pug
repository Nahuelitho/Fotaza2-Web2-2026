extends ../layouts/main

block content
  .auth-shell.container
    .auth-grid
      include ../partials/auth-aside

      section.auth-card.card-soft
        .section-heading.auth-card__heading
          h2 Recuperar contrasena
          p Vista preparada para el flujo futuro de recuperacion de acceso.

        form.auth-form(action='#', method='post')
          label.auth-field
            span Correo electronico
            input(type='email', name='email', placeholder='correo@ejemplo.com')

          .auth-form__actions
            button.button(type='submit') Enviar enlace
            a.auth-link(href='/login') Volver a iniciar sesion

          p.auth-note
            | Cuando integremos autenticacion real, aqui enviaremos instrucciones de recuperacion.
