extends ../layouts/main

block content
  .auth-shell.container
    .auth-grid
      include ../partials/auth-aside

      section.auth-card.card-soft
        .section-heading.auth-card__heading
          h2 Crear cuenta

        if errorMessage
          p.form-message.form-message--error= errorMessage

        form.auth-form(action='/register', method='post')
          .auth-form__row
            label.auth-field
              span Nombre visible
              input(type='text', name='displayName', placeholder='Como quieres que se vea tu nombre', value=(formData && formData.displayName) || '')

            label.auth-field
              span Usuario
              input(type='text', name='username', placeholder='Elige tu nombre de usuario', value=(formData && formData.username) || '')

          label.auth-field
            span Correo electronico
            input(type='email', name='email', placeholder='correo@ejemplo.com', value=(formData && formData.email) || '')

          .auth-form__row
            label.auth-field
              span Contrasena
              input(type='password', name='password', placeholder='Crea una contrasena')

            label.auth-field
              span Confirmar contraseña
              input(type='password', name='confirmPassword', placeholder='Repite la contrasena')

          .auth-form__actions
            button.button(type='submit') Crear cuenta
            a.auth-link(href='/login') Ya tengo cuenta
